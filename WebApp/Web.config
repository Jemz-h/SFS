<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="StudentFeedbackDb"
         connectionString="Server=localhost\SQLEXPRESS;Database=StudentFeedbackSystem;Trusted_Connection=True;MultipleActiveResultSets=true;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="MaxLoginAttempts" value="5" />
    <add key="LockoutMinutes" value="15" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" requestValidationMode="4.8" />

    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx"
             timeout="30"
             requireSSL="false"
             cookieless="UseCookies"
             slidingExpiration="true"
             protection="All" />
      <!-- Set requireSSL="true" in production once HTTPS is enforced (see README). -->
    </authentication>

    <authorization>
      <!-- Anonymous users may only reach Login/Register/PendingStatus and static assets;
           everything else is denied here and re-opened per-folder below. -->
      <deny users="?" />
    </authorization>

    <machineKey validationKey="AutoGenerate,IsolateApps"
                decryptionKey="AutoGenerate,IsolateApps"
                validation="HMACSHA256"
                decryption="Auto" />

    <pages validateRequest="true" enableViewStateMac="true" />

    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
  </system.web>

  <!-- Anonymous-accessible pages (must sit outside protected folders). -->
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Register.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="PendingStatus.aspx">
    <system.web>
      <authorization>
        <allow users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!-- Folder-level role rules — first layer of defense in depth (see Security/BasePage.cs for the second). -->
  <location path="StudentPages">
    <system.web>
      <authorization>
        <deny users="?" />
        <!-- Role checks (Student) are enforced in code-behind via StudentBasePage,
             since classic Forms Auth roles require a RoleProvider wired to the DB;
             this rule only guarantees the user is authenticated at all. -->
      </authorization>
    </system.web>
  </location>

  <location path="AdminPages">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Add Web Forms runtime binding redirects here as package dependencies require them. -->
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions"
                          culture="neutral"
                          publicKeyToken="cc7b13ffcd2ddd51" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
